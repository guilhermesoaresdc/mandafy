# ─────────────────────────────────────────────────────────────────────────────
# Mandafy — variáveis de ambiente (§16 da especificação)
# Copie para .env e preencha. Nunca versione o .env.
#
# Gerar segredos:
#   SESSION_SECRET:  openssl rand -hex 32
#   ENCRYPTION_KEY:  openssl rand -hex 32     (exatamente 64 caracteres hex)
# ─────────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=
ENCRYPTION_KEY=

# Banco / fila
# Em docker compose os hosts são os nomes dos serviços (postgres, redis).
DATABASE_URL=postgresql://mandafy:mandafy@postgres:5432/mandafy
REDIS_URL=redis://redis:6379

# Credenciais do Postgres dentro do compose (usadas só pelo serviço postgres)
POSTGRES_USER=mandafy
POSTGRES_PASSWORD=mandafy
POSTGRES_DB=mandafy

# Evolution API (WhatsApp — §8.2)
# Fixe a tag da imagem no docker-compose, nunca use :latest.
EVOLUTION_URL=http://evolution:8080
EVOLUTION_GLOBAL_APIKEY=

# E-mail (§8.3) — resend | ses | brevo
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Mandafy <envio@seudominio.com.br>"

# SMS (§8.4) — smsdev | comtele | zenvia
SMS_PROVIDER=smsdev
SMS_API_KEY=
SMS_SENDER=

# Telegram (§8.5)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Operação (§7.4, §10.2)
DEFAULT_TIMEZONE=America/Sao_Paulo
QUIET_HOURS_START=21:00
QUIET_HOURS_END=08:00
LOG_RETENTION_DAYS=3
ARCHIVE_RETENTION_DAYS=30

# Encurtador de links usado na variante SMS (§6.4). Deixe vazio para não encurtar.
SHORTLINK_DOMAIN=

# Domínio que o Caddy vai servir com TLS automático em produção.
# Em desenvolvimento deixe como está (o compose usa localhost sem TLS).
CADDY_DOMAIN=localhost
CADDY_EMAIL=
