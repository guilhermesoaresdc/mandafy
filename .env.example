# ─────────────────────────────────────────────────────────────────────────────
# Mandafy — variáveis de ambiente (§16 da especificação)
# Copie para .env e preencha. Nunca versione o .env.
#
# Gerar segredos:
#   SESSION_SECRET:  openssl rand -hex 32
#   ENCRYPTION_KEY:  openssl rand -hex 32     (exatamente 64 caracteres hex)
# ─────────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=
ENCRYPTION_KEY=

# Banco / fila
# Em docker compose os hosts são os nomes dos serviços (postgres, redis).
#
# Dois papéis, de propósito (ver drizzle/0010_rls.sql):
#   DATABASE_URL        → mandafy_app, papel da aplicação. RLS SEMPRE aplicado.
#                         É o que o app e o worker usam. É aqui que o
#                         isolamento entre organizações e o "consultor só vê os
#                         próprios leads" são garantidos pelo banco.
#   DATABASE_URL_ADMIN  → dono das tabelas. Ignora RLS. Só db:migrate e db:seed.
#                         Se ficar vazio, cai para DATABASE_URL.
DATABASE_URL=postgresql://mandafy_app:mandafy_app@postgres:5432/mandafy
DATABASE_URL_ADMIN=postgresql://mandafy:mandafy@postgres:5432/mandafy
REDIS_URL=redis://redis:6379

# Credenciais do Postgres dentro do compose (usadas só pelo serviço postgres)
POSTGRES_USER=mandafy
POSTGRES_PASSWORD=mandafy
POSTGRES_DB=mandafy
# Senha do papel da aplicação, criado pelo docker/postgres/init.sql
POSTGRES_APP_PASSWORD=mandafy_app

# Segredo do batimento periódico (§7.1).
#
# Só é necessário para quem NÃO roda o worker — publicação só na Vercel, por
# exemplo. Uma requisição a /api/cron com este segredo faz o que o worker faria:
# envia o que venceu e roda a manutenção.
#
# Sem esta variável a rota recusa TODAS as chamadas, inclusive as legítimas. É
# deliberado: um endpoint que dispara mensagem sem pedir credencial é um
# endpoint que qualquer um usa para queimar seus números.
#
# Gere com: openssl rand -hex 32
CRON_SECRET=

# Aplicar as migrations pendentes na subida do app.
# Ligado por padrão — é o que permite migrar sem terminal. Desligue com `false`
# se preferir aplicar num passo separado do deploy.
AUTO_MIGRATE=

# Usuário administrador criado pelo `npm run db:seed`.
# Se a senha ficar vazia, o seed gera uma aleatória e imprime no console.
SEED_ADMIN_EMAIL=admin@mandafy.local
SEED_ADMIN_PASSWORD=

# Evolution API (WhatsApp — §8.2)
# Fixe a tag da imagem no docker-compose, nunca use :latest.
EVOLUTION_URL=http://evolution:8080
EVOLUTION_GLOBAL_APIKEY=

# E-mail (§8.3) — resend | ses | brevo
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Prêmia Bicho <nao-responda@envio.premiabicho.com>"

# SMS (§8.4) — smsdev | comtele | zenvia
SMS_PROVIDER=smsdev
SMS_API_KEY=
SMS_SENDER=

# Telegram (§8.5)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Operação (§7.4, §10.2)
DEFAULT_TIMEZONE=America/Sao_Paulo
QUIET_HOURS_START=21:00
QUIET_HOURS_END=08:00
LOG_RETENTION_DAYS=3
ARCHIVE_RETENTION_DAYS=30

# Encurtador de links usado na variante SMS (§6.4). Deixe vazio para não encurtar.
SHORTLINK_DOMAIN=

# Domínio que o Caddy vai servir com TLS automático em produção.
# Em desenvolvimento deixe como está (o compose usa localhost sem TLS).
CADDY_DOMAIN=localhost
CADDY_EMAIL=
